NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://eve:eve_secret@localhost:5432/eve_healthcare?schema=public
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
PAYMENT_WEBHOOK_SECRET=webhook-shared-secret
PAYMENT_SUCCESS_RATE=0.8
REDIS_URL=redis://127.0.0.1:56379
CENTRE_CACHE_TTL_SECONDS=60
WEBHOOK_QUEUE_NAME=payment-webhooks
WEBHOOK_RETRY_ATTEMPTS=5
WEBHOOK_RETRY_DELAY_MS=1000
