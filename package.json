{
  "name": "eve-healthcare-backend",
  "version": "1.0.0",
  "description": "Diagnostic test bookings and simulated payments — EVE Healthcare SDE Intern assignment",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "setup": "prisma generate && prisma db push && node prisma/seed.js",
    "test": "jest --runInBand --forceExit",
    "test:ci": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "redis": "^6.2.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "supertest": "^7.0.0"
  }
}
